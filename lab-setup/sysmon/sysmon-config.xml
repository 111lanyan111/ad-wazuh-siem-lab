<!--
  Sysmon 配置文件 - AD + Wazuh SIEM 实验室专用
  基于 SwiftOnSecurity/sysmon-config 精简优化
  覆盖：进程创建、网络连接、文件创建、注册表修改、驱动加载、凭证窃取检测
-->
<Sysmon schemaversion="4.82">
  <!-- 捕获所有进程的哈希 -->
  <HashAlgorithms>*</HashAlgorithms>
  <CheckRevocation/>

  <!-- 事件日志归档 -->
  <ArchiveDirectory>Sysmon</ArchiveDirectory>

  <!-- ========== Event ID 1: 进程创建 ========== -->
  <ProcessCreate onmatch="exclude">
    <!-- 排除系统正常进程，减少噪音 -->
    <Image condition="end with">\svchost.exe</Image>
    <Image condition="end with">\services.exe</Image>
    <Image condition="end with">\lsass.exe</Image>
    <Image condition="end with">\wininit.exe</Image>
    <Image condition="end with">\csrss.exe</Image>
    <Image condition="end with">\smss.exe</Image>
    <Image condition="end with">\winlogon.exe</Image>
    <Image condition="end with">\System</Image>
    <Image condition="end with">\Registry</Image>
    <Image condition="end with">\Memory Compression</Image>
  </ProcessCreate>

  <!-- 重点监控可疑进程创建（include 优先级高于 exclude） -->
  <ProcessCreate onmatch="include">
    <!-- 凭证窃取工具 -->
    <Image condition="contains">mimikatz</Image>
    <Image condition="contains">mimikatz.exe</Image>
    <Image condition="contains">procdump</Image>
    <Image condition="contains">comsvcs.dll</Image>
    <Image condition="contains">rundll32.exe</Image>
    <!-- 横向移动工具 -->
    <Image condition="contains">psexec</Image>
    <Image condition="contains">paexec</Image>
    <Image condition="contains">wmic.exe</Image>
    <Image condition="contains">winrm.vbs</Image>
    <Image condition="contains">cscript.exe</Image>
    <!-- 权限提升工具 -->
    <Image condition="contains">juicypotato</Image>
    <Image condition="contains">rottenpotato</Image>
    <Image condition="contains">printspoofer</Image>
    <Image condition="contains">godpotato</Image>
    <!-- 攻击框架 -->
    <Image condition="contains">cobaltstrike</Image>
    <Image condition="contains">metasploit</Image>
    <Image condition="contains">empire</Image>
    <!-- PowerShell 可疑执行 -->
    <Image condition="end with">\powershell.exe</Image>
    <Image condition="end with">\pwsh.exe</Image>
    <Image condition="end with">\cmd.exe</Image>
  </ProcessCreate>

  <!-- ========== Event ID 3: 网络连接 ========== -->
  <NetworkConnect onmatch="exclude">
    <!-- 排除本地回环和内网正常通信 -->
    <DestinationIp condition="is">127.0.0.1</DestinationIp>
    <DestinationIp condition="is">::1</DestinationIp>
    <Image condition="end with">\svchost.exe</Image>
  </NetworkConnect>

  <NetworkConnect onmatch="include">
    <!-- 监控可疑端口出站 -->
    <DestinationPort condition="is">4444</DestinationPort>
    <DestinationPort condition="is">4443</DestinationPort>
    <DestinationPort condition="is">8080</DestinationPort>
    <DestinationPort condition="is">8443</DestinationPort>
    <DestinationPort condition="is">9001</DestinationPort>
    <!-- 监控 SMB/RDP/WinRM 出站（横向移动） -->
    <DestinationPort condition="is">445</DestinationPort>
    <DestinationPort condition="is">3389</DestinationPort>
    <DestinationPort condition="is">5985</DestinationPort>
    <DestinationPort condition="is">5986</DestinationPort>
    <!-- 可疑进程发起的网络连接 -->
    <Image condition="contains">powershell.exe</Image>
    <Image condition="contains">cmd.exe</Image>
    <Image condition="contains">rundll32.exe</Image>
    <Image condition="contains">regsvr32.exe</Image>
    <Image condition="contains">mshta.exe</Image>
    <Image condition="contains">cscript.exe</Image>
    <Image condition="contains">wscript.exe</Image>
  </NetworkConnect>

  <!-- ========== Event ID 5: 进程终止 ========== -->
  <ProcessTerminate onmatch="include">
    <Image condition="contains">lsass.exe</Image>
    <Image condition="contains">csrss.exe</Image>
    <Image condition="contains">wininit.exe</Image>
  </ProcessTerminate>

  <!-- ========== Event ID 6: 驱动加载 ========== -->
  <DriverLoad onmatch="exclude">
    <Signature condition="contains">Microsoft Windows</Signature>
    <Signature condition="contains">Microsoft Corporation</Signature>
  </DriverLoad>

  <!-- ========== Event ID 7: 镜像加载（DLL） ========== -->
  <ImageLoad onmatch="include">
    <!-- 监控可疑 DLL 加载到 lsass（凭证窃取） -->
    <ImageLoaded condition="contains">mimikatz</ImageLoaded>
    <ImageLoaded condition="contains">sekurlsa</ImageLoaded>
    <Image condition="end with">\lsass.exe</Image>
  </ImageLoad>

  <!-- ========== Event ID 8: CreateRemoteThread ========== -->
  <CreateRemoteThread onmatch="include">
    <!-- 远程线程注入到关键进程 -->
    <TargetImage condition="end with">\lsass.exe</TargetImage>
    <TargetImage condition="end with">\explorer.exe</TargetImage>
    <TargetImage condition="end with">\svchost.exe</TargetImage>
    <TargetImage condition="end with">\winlogon.exe</TargetImage>
  </CreateRemoteThread>

  <!-- ========== Event ID 11: 文件创建 ========== -->
  <FileCreate onmatch="include">
    <!-- 启动目录 -->
    <TargetFilename condition="contains">\Start Menu\Programs\Startup</TargetFilename>
    <!-- 临时目录可执行文件 -->
    <TargetFilename condition="contains">\AppData\Local\Temp</TargetFilename>
    <TargetFilename condition="end with">.exe</TargetFilename>
    <TargetFilename condition="end with">.dll</TargetFilename>
    <TargetFilename condition="end with">.ps1</TargetFilename>
    <TargetFilename condition="end with">.bat</TargetFilename>
    <TargetFilename condition="end with">.vbs</TargetFilename>
    <!-- Sysmon 配置文件修改 -->
    <TargetFilename condition="contains">sysmon</TargetFilename>
  </FileCreate>

  <!-- ========== Event ID 12/13/14: 注册表事件 ========== -->
  <RegistryEvent onmatch="include">
    <!-- 运行键（持久化） -->
    <TargetObject condition="contains">\Software\Microsoft\Windows\CurrentVersion\Run</TargetObject>
    <TargetObject condition="contains">\Software\Microsoft\Windows\CurrentVersion\RunOnce</TargetObject>
    <!-- 映像劫持（权限提升/防御绕过） -->
    <TargetObject condition="contains">\Image File Execution Options</TargetObject>
    <!-- Sysmon 配置修改 -->
    <TargetObject condition="contains">\Sysmon</TargetObject>
    <!-- 服务创建（持久化/横向移动） -->
    <TargetObject condition="contains">\CurrentControlSet\Services</TargetObject>
  </RegistryEvent>

  <!-- ========== Event ID 15: FileCreateStreamHash（ADS） ========== -->
  <FileCreateStreamHash onmatch="include">
    <TargetFilename condition="end with">.exe</TargetFilename>
    <TargetFilename condition="end with">.dll</TargetFilename>
    <TargetFilename condition="end with">.ps1</TargetFilename>
  </FileCreateStreamHash>

  <!-- ========== Event ID 17/18: 命名管道 ========== -->
  <PipeEvent onmatch="include">
    <!-- 凭证窃取相关管道 -->
    <PipeName condition="contains">\mimikatz</PipeName>
    <PipeName condition="contains">\sekurlsa</PipeName>
    <!-- PsExec 管道 -->
    <PipeName condition="contains">\psexec</PipeName>
    <PipeName condition="contains">\paexec</PipeName>
    <!-- C2 常见管道名 -->
    <PipeName condition="contains">\cobaltstrike</PipeName>
    <PipeName condition="contains">\msagent</PipeName>
  </PipeEvent>

  <!-- ========== Event ID 19/20/21: WMI 事件 ========== -->
  <WmiEvent onmatch="include">
    <Operation condition="is">WmiFilterConsumerBinding</Operation>
  </WmiEvent>

  <!-- ========== Event ID 22: DNS 查询 ========== -->
  <DnsQuery onmatch="exclude">
    <QueryName condition="end with">.corp.local</QueryName>
    <QueryName condition="is">localhost</QueryName>
  </DnsQuery>

  <DnsQuery onmatch="include">
    <Image condition="contains">powershell.exe</Image>
    <Image condition="contains">cmd.exe</Image>
    <Image condition="contains">rundll32.exe</Image>
    <Image condition="contains">mshta.exe</Image>
  </DnsQuery>

  <!-- ========== Event ID 255: 配置修改 ========== -->
  <ConfigChange onmatch="include"/>
</Sysmon>
